FITNESS_APP_NAME=Fitness Tracker API
FITNESS_APP_ENV=development
FITNESS_DEBUG=true
FITNESS_API_V1_PREFIX=/api/v1
FITNESS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fitness_tracker
FITNESS_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://your-frontend-project.vercel.app"]
FITNESS_DEFAULT_PROFILE_ID=1
FITNESS_USE_NULL_POOL=false
FITNESS_STORAGE_BACKEND=local
FITNESS_BLOB_READ_WRITE_TOKEN=
FITNESS_BLOB_API_BASE_URL=https://blob.vercel-storage.com
FITNESS_MEDIA_URL_PREFIX=/media
